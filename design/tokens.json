{
  "name": "Mythos Design System Tokens",
  "version": "1.0.0",
  "brand": {
    "name": "MYTHOS",
    "tagline": "BUILD SKILLS. BUILD SYSTEMS. BUILD THE FUTURE.",
    "mission": "Controlled tech learning system focused on practical execution, real-world data systems, and verified capability."
  },
  "typography": {
    "primary": {
      "family": "Poppins",
      "fallbacks": ["Inter", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif"],
      "google_font_url": "https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap",
      "weights": {
        "light": 300,
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700,
        "extrabold": 800,
        "black": 900
      }
    },
    "monospace": {
      "family": "JetBrains Mono",
      "fallbacks": ["ui-monospace", "SFMono-Regular", "Menlo", "Monaco", "Consolas", "monospace"],
      "weights": {
        "regular": 400,
        "medium": 500,
        "bold": 700
      }
    }
  },
  "colors": {
    "background": {
      "dark_navy": "#070B14",
      "card_dark": "#0B1120",
      "surface_dark": "#0F172A",
      "light": "#FFFFFF",
      "card_light": "#F8FAFC",
      "surface_light": "#F1F5F9"
    },
    "text": {
      "dark_primary": "#FFFFFF",
      "dark_secondary": "#94A3B8",
      "dark_muted": "#64748B",
      "light_primary": "#0F172A",
      "light_secondary": "#475569",
      "light_muted": "#94A3B8"
    },
    "brand_spectrum": {
      "electric_blue": "#2563EB",
      "royal_blue": "#1E3A8A",
      "cyan": "#06B6D4",
      "violet": "#7C3AED",
      "magenta": "#EC4899",
      "orange": "#F97316",
      "emerald": "#10B981"
    },
    "gradients": {
      "mythos_primary": "linear-gradient(135deg, #2563EB 0%, #7C3AED 50%, #F97316 100%)",
      "blue_cyan": "linear-gradient(135deg, #2563EB 0%, #06B6D4 100%)",
      "violet_magenta": "linear-gradient(135deg, #7C3AED 0%, #EC4899 100%)",
      "dark_glow": "linear-gradient(180deg, rgba(37, 99, 235, 0.15) 0%, rgba(249, 115, 22, 0.08) 100%)"
    }
  },
  "certificate_specifications": {
    "standard_format": "A4 Landscape",
    "dimensions_mm": {
      "width": 297,
      "height": 210
    },
    "dimensions_px_300dpi": {
      "width": 3508,
      "height": 2480
    },
    "margins_mm": {
      "top": 18,
      "bottom": 18,
      "left": 20,
      "right": 20
    },
    "border_spec": {
      "outer_border_width_px": 8,
      "outer_border_color": "#1E3A8A",
      "inner_frame_width_px": 2,
      "inner_frame_color": "#2563EB",
      "corner_accent_color": "#F97316"
    },
    "serial_id_pattern": "MYTHOS-DA-{YYYY}-{COHORT_ID}{STUDENT_SEQ}",
    "serial_id_example": "MYTHOS-DA-2026-B1042",
    "typography": {
      "institution_header": {
        "font": "Poppins Black",
        "size_pt": 22,
        "color": "#070B14",
        "letter_spacing_pt": 4
      },
      "award_title": {
        "font": "Poppins SemiBold",
        "size_pt": 13,
        "color": "#2563EB",
        "text_transform": "uppercase",
        "letter_spacing_pt": 2.5
      },
      "candidate_name": {
        "font": "Poppins Bold",
        "size_pt": 32,
        "color": "#0F172A",
        "decoration": "Underline or colored accent bar beneath"
      },
      "course_title": {
        "font": "Poppins Bold",
        "size_pt": 18,
        "color": "#1E3A8A"
      },
      "body_citation": {
        "font": "Poppins Regular",
        "size_pt": 11,
        "color": "#475569",
        "line_height_multiplier": 1.6
      },
      "meta_labels": {
        "font": "JetBrains Mono Medium",
        "size_pt": 9,
        "color": "#64748B"
      }
    },
    "pillars_accredited": [
      "Python ETL & Scripting",
      "Relational SQL Architecture",
      "Power BI Business Intelligence",
      "Excel Financial & Data Modeling",
      "Tableau Visual Storytelling"
    ],
    "verification_url_template": "https://mythostech.in/verify/{CERTIFICATE_ID}",
    "signatories": [
      {
        "role": "Lead Technical Mentor",
        "title": "Data Systems & Architecture Lead"
      },
      {
        "role": "Program Director",
        "title": "Director of Analytics & Admission"
      }
    ]
  }
}
